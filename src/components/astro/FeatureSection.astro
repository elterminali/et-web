---
import type { Locale } from '../../i18n/config';
import { t } from '../../i18n/config';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const i18n = t(locale);
const c = i18n.capabilities;

const features = [
  { title: c.barcodeTitle, desc: c.barcodeDescription, icon: 'barcode', gradient: '--gradient-blue' },
  { title: c.lotTitle, desc: c.lotDescription, icon: 'lot', gradient: '--gradient-purple' },
  { title: c.warehouseTitle, desc: c.warehouseDescription, icon: 'warehouse', gradient: '--gradient-indigo' },
  { title: c.transactionsTitle, desc: c.transactionsDescription, icon: 'transactions', gradient: '--gradient-green' },
  { title: c.customersTitle, desc: c.customersDescription, icon: 'customers', gradient: '--gradient-orange' },
  { title: c.teamTitle, desc: c.teamDescription, icon: 'team', gradient: '--gradient-blue' },
  { title: c.customFieldsTitle, desc: c.customFieldsDescription, icon: 'fields', gradient: '--gradient-purple' },
  { title: c.reportsTitle, desc: c.reportsDescription, icon: 'reports', gradient: '--gradient-green' },
  { title: c.importExportTitle, desc: c.importExportDescription, icon: 'import', gradient: '--gradient-orange' },
  { title: c.alertsTitle, desc: c.alertsDescription, icon: 'alert', gradient: '--gradient-indigo' },
  { title: c.currencyTitle, desc: c.currencyDescription, icon: 'currency', gradient: '--gradient-blue' },
  { title: c.platformsTitle, desc: c.platformsDescription, icon: 'platforms', gradient: '--gradient-purple' },
];

// SVG icon paths (inline, no external dependencies)
const icons: Record<string, string> = {
  barcode: 'M4 7v10M8 7v10M12 7v10M16 7v10M20 7v10M2 9h1M21 9h1M2 15h1M21 15h1',
  lot: 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4',
  warehouse: 'M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2zM9 22V12h6v10',
  transactions: 'M7 16V4m0 0L3 8m4-4l4 4M17 8v12m0 0l4-4m-4 4l-4-4',
  customers: 'M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2M9 11a4 4 0 100-8 4 4 0 000 8zM23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75',
  team: 'M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197',
  fields: 'M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z',
  reports: 'M18 20V10M12 20V4M6 20v-6',
  import: 'M12 2v13m0 0l-4-4m4 4l4-4M3 17.5V19a2 2 0 002 2h14a2 2 0 002-2v-1.5',
  alert: 'M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9',
  currency: 'M12 2C6.477 2 2 6.477 2 12s4.477 10 10 10 10-4.477 10-10S17.523 2 12 2zm0 0v2m0 16v2M8 12h8m-4-4v8',
  platforms: 'M9 17H7A5 5 0 017 7h2M15 7h2a5 5 0 110 10h-2M8 12h8',
};
---
<section class="features section" id="features">
  <div class="section-inner">
    <div class="section-header">
      <span class="section-badge" aria-hidden="true">{c.badge}</span>
      <h2 class="section-title">{c.title}</h2>
      <p class="section-description">{c.description}</p>
    </div>
    <div class="features-grid">
      {features.map(({ title, desc, icon, gradient }) => (
        <article class="feature-card">
          <div class="feature-icon" style={`background: var(${gradient})`} aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d={icons[icon]} />
            </svg>
          </div>
          <div>
            <h3>{title}</h3>
            <p>{desc}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .features { background: #fafafa; }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
  }

  .feature-card {
    background: #fff;
    border-radius: var(--radius-2xl);
    padding: var(--space-6);
    box-shadow: var(--shadow-sm);
    border: 1px solid rgba(0,0,0,0.04);
    display: flex;
    gap: var(--space-4);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .feature-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); }

  .feature-icon {
    width: 52px; height: 52px; flex-shrink: 0;
    border-radius: var(--radius-lg);
    display: flex; align-items: center; justify-content: center;
  }
  .feature-icon svg { width: 24px; height: 24px; color: #fff; }

  .feature-card h3 { font-size: 1rem; font-weight: 700; color: #1a1a1a; margin-bottom: 4px; }
  .feature-card p { font-size: 0.875rem; color: #666; line-height: 1.55; }

  @media (max-width: 768px) {
    .features-grid { grid-template-columns: 1fr; }
  }

  @media (prefers-reduced-motion: reduce) {
    .feature-card:hover { transform: none; }
  }
</style>
