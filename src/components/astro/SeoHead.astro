---
import type { Locale } from '../../i18n/config';
import { SITE } from '../../config/site';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  canonicalPath: string; // e.g. "/" or "/features/"
  noindex?: boolean;
}

const { title, description, locale, canonicalPath, noindex = false } = Astro.props;

const localePrefix = locale === 'en' ? '' : `/${locale}`;
const canonicalUrl = `${SITE.url}${localePrefix}${canonicalPath === '/' ? '' : canonicalPath}`;

// Build hreflang alternates
const langPaths = [
  { lang: 'x-default', url: `${SITE.url}${canonicalPath === '/' ? '' : canonicalPath}` },
  { lang: 'en',        url: `${SITE.url}${canonicalPath === '/' ? '' : canonicalPath}` },
  { lang: 'tr',        url: `${SITE.url}/tr${canonicalPath === '/' ? '' : canonicalPath}` },
  { lang: 'de',        url: `${SITE.url}/de${canonicalPath === '/' ? '' : canonicalPath}` },
];

const ogLocaleMap: Record<Locale, string> = { en: 'en_US', tr: 'tr_TR', de: 'de_DE' };
const ogLocale = ogLocaleMap[locale];
const ogImage = `${SITE.url}${SITE.ogImage}`;
---
<!-- Primary -->
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<!-- hreflang alternates — only for canonical pages (not alias/noindex) -->
{!noindex && langPaths.map(({ lang, url }) => (
  <link rel="alternate" hreflang={lang} href={url} />
))}

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="eltrm — inventory management" />
<meta property="og:locale" content={ogLocale} />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<!-- Favicon -->
<link rel="icon" type="image/x-icon" href="/favicon.ico" />
<link rel="icon" type="image/png" sizes="32x32" href="/assets/img/logo-small.png" />
<link rel="apple-touch-icon" href="/assets/img/logo.png" />
