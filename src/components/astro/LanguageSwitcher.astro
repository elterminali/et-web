---
import type { Locale } from '../../i18n/config';
import { t } from '../../i18n/config';

interface Props {
  locale: Locale;
  currentPath: string; // e.g. "/" or "/features/"
}

const { locale, currentPath } = Astro.props;
const i18n = t(locale);

// Build language URLs: EN at root, TR and DE prefixed
const langs: Array<{ code: Locale; label: string; href: string }> = [
  { code: 'en', label: 'EN', href: currentPath === '/' ? '/' : currentPath },
  { code: 'tr', label: 'TR', href: `/tr${currentPath === '/' ? '' : currentPath}` },
  { code: 'de', label: 'DE', href: `/de${currentPath === '/' ? '' : currentPath}` },
];
---
<nav aria-label={i18n.nav.languageLabel} class="lang-switcher">
  {langs.map(({ code, label, href }) => (
    <a
      href={href}
      class:list={['lang-btn', { active: code === locale }]}
      aria-current={code === locale ? 'page' : undefined}
      hreflang={code}
    >
      {label}
    </a>
  ))}
</nav>

<style>
  .lang-switcher {
    display: flex;
    gap: 4px;
    background: rgba(0, 0, 0, 0.05);
    border-radius: var(--radius-md);
    padding: 4px;
  }
  .lang-btn {
    padding: 6px 10px;
    border-radius: var(--radius-sm);
    font-weight: 600;
    font-size: 0.8125rem;
    color: #555;
    text-decoration: none;
    transition: background 0.15s ease, color 0.15s ease;
    line-height: 1;
    min-height: 32px;
    display: flex;
    align-items: center;
  }
  .lang-btn:hover { background: rgba(0,0,0,0.08); color: var(--blue); text-decoration: none; }
  .lang-btn.active { background: var(--gradient-blue); color: #fff; }
</style>
