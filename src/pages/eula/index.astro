---
import LegalLayout from '../../layouts/LegalLayout.astro';
import { t } from '../../i18n/config';
const locale = 'en'; const i18n = t(locale);
---
<LegalLayout locale={locale} title={i18n.meta.eulaTitle} description={i18n.meta.eulaDescription} canonicalPath="/eula/" lastUpdated="January 2026">
