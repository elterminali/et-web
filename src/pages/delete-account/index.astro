---
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import { t } from '../../i18n/config';
import { SITE } from '../../config/site';
const locale = 'en'; const i18n = t(locale); const da = i18n.deleteAccount;
---
<MarketingLayout locale={locale} title={i18n.meta.deleteAccountTitle} description={i18n.meta.deleteAccountDescription} canonicalPath="/delete-account/">
  <section class="section" style="padding-top:calc(var(--nav-height)+var(--space-12));background:#fafafa;min-height:100vh">
    <div class="section-inner" style="max-width:680px">
      <div class="section-header">
        <h1 class="section-title">{da.title}</h1>
        <p class="section-description">{da.subtitle}</p>
      </div>
      <p style="color:#555;margin-bottom:var(--space-8)">{da.description}</p>
      <h2 style="font-size:1.25rem;margin-bottom:var(--space-6);color:#1a1a1a">{da.howToTitle}</h2>
      <ol style="display:flex;flex-direction:column;gap:var(--space-4);list-style:none;counter-reset:steps">
        {[
          [da.step1Title, da.step1Description],
          [da.step2Title, da.step2Description],
          [da.step3Title, da.step3Description],
        ].map(([title, desc], idx) => (
          <li style="display:flex;gap:var(--space-4);background:#fff;border-radius:var(--radius-xl);padding:var(--space-6);border:1px solid rgba(0,0,0,.06)">
            <div style="width:36px;height:36px;border-radius:50%;background:var(--gradient-blue);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;flex-shrink:0">{idx+1}</div>
            <div>
              <strong style="display:block;font-weight:700;margin-bottom:4px">{title}</strong>
              <p style="color:#666;font-size:.9375rem;line-height:1.6">{desc}</p>
            </div>
          </li>
        ))}
      </ol>
      <div style="margin-top:var(--space-8);display:flex;gap:var(--space-4);flex-wrap:wrap">
        <a href={`mailto:${SITE.email}?subject=Account%20Deletion%20Request`} class="btn btn-primary">{da.emailButton}</a>
        <a href="/" class="btn btn-outline">{da.backHome}</a>
      </div>
    </div>
  </section>
</MarketingLayout>
