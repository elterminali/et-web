</LegalLayout>

<style is:global>
  .legal-inner h1 { font-size: 1.75rem; margin-bottom: var(--space-3); }
  .legal-inner h2 { font-size: 1.25rem; margin: var(--space-8) 0 var(--space-3); color: #111; }
  .legal-inner p { color: #444; line-height: 1.75; margin-bottom: var(--space-4); }
  .legal-inner address { font-style: normal; background: #f5f6f8; border-radius: var(--radius-lg); padding: var(--space-6); line-height: 2; margin-bottom: var(--space-6); color: #444; }
</style>
