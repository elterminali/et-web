---
import MarketingLayout from '../../../layouts/MarketingLayout.astro';
import FeatureSection from '../../../components/astro/FeatureSection.astro';
import { t } from '../../../i18n/config';
const locale = 'tr'; const i18n = t(locale);
---
<MarketingLayout locale={locale} title={i18n.meta.featuresTitle} description={i18n.meta.featuresDescription} canonicalPath="/features/">
  <div style="padding-top: var(--nav-height)"><FeatureSection locale={locale} /></div>
</MarketingLayout>
